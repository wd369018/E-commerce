# Local databases (build artifacts - regenerate with: py -3.14 -m src.database)
data/*.db
data/*.sqlite
data/*.sqlite3

# Raw and processed datasets (regenerate with the ETL pipeline)
data/raw/
data/processed/
data/quarantine/
# NB: data/processed.tar.gz is committed on purpose - app/app.py extracts it on
# first run so the app self-bootstraps on Streamlit Cloud. The unpacked
# data/processed/ directory itself stays ignored.

# Raw Olist CSVs kept at the project root
olist_*.csv
product_category_name_translation.csv

